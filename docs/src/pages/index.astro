---
import { getCollection, render } from 'astro:content';
import '../styles/styles.css';
import arrow from "../assets/arrow-dropdown.webp";
const intro = await getCollection('intro');
intro.sort((a, b) => a.data.order - b.data.order);
const stations = await getCollection('stations');
stations.sort((a, b) => a.data.order - b.data.order);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<title>PraySkyline</title>
	</head>
	<body>
		<nav class="navbar">
			<!-- Dropdown https://getbootstrap.com/docs/5.0/components/dropdowns/ -->
			<div class="dropdown">
				<button class="dropdown-button">Stations <img src={arrow.src} width="25" height="25" alt="dropdown menu arrow"></button>
				<div class="dropdown-content">
					<a href="#station-1">1 Kualakaʻi</a>
					<a href="#station-2">2 Keoneʻae</a>
					<a href="#station-3">3 Honouliuli</a>
					<a href="#station-4">4 Hō‘ae‘ae</a>
					<a href="#station-5">5 Pouhala</a>
					<a href="#station-6">6 Hālaulani</a>
					<a href="#station-7">7 Waiawa</a>
					<a href="#station-8">8 Kalauao</a>
					<a href="#station-9">9 Hālawa</a>
					<a href="#station-10">10 Makalapa</a>
					<a href="#station-11">11 Lelepaua</a>
					<a href="#station-12">12 Āhua</a>
					<a href="#station-13">13 Kahauiki</a>
				</div>
			</div>
      		<!-- Navbar will go here -->
    	</nav>
		<h1>PraySkyline</h1>
		<main>
		{intro.map(async (intr) => {
		const { Content } = await render(intr);
		return (
			<section id={`intr-${intr.data.order}`}>
				<Content />
			</section>
		);
		})}

		<h1>Station Info & Prayer Guide</h1>
      	{stations.map(async (station) => {
        const { Content } = await render(station);
        return (
          <section id={`station-${station.data.order}`}>
            <h2>{station.data.title}</h2>
            <Content />
          </section>
        );
      })}
    </main>
	</body>
</html>
